<% layout("/layouts/boilerplate") %>

<style>
  #filters {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    margin-top: 1rem;
  }

  .category-filters {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .category-filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: 0 0 auto;
    min-width: 4.5rem;
    text-align: center;
    opacity: 0.7;
    text-decoration: none;
    color: #222222;
    padding: 0.75rem 0 0.5rem;
    border-bottom: 2px solid transparent;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter p {
    font-size: 0.8rem;
    margin: 0.35rem 0 0;
    white-space: nowrap;
  }

  .filter.active {
    opacity: 1;
    border-bottom-color: #222222;
  }

  .tax-info {
    display: none;
  }

  .tax-toggle {
    flex: 0 0 auto;
    border: 1px solid #ddd;
    border-radius: 1.5rem;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    background: #fff;
    white-space: nowrap;
  }

  .tax-toggle .form-check {
    margin: 0;
  }

  @media (max-width: 768px) {
    #filters {
      align-items: flex-start;
    }

    .category-filters {
      gap: 1rem;
    }

    .filter {
      min-width: 4rem;
    }

    .tax-toggle {
      padding: 0.65rem 0.8rem;
    }

    .tax-toggle .form-check-label {
      display: none;
    }
  }

  @media (max-width: 576px) {
    #filters {
      gap: 0.5rem;
    }

    .tax-toggle {
      min-height: 2.75rem;
      margin-top: 0.45rem;
    }
  }
</style>

<div id="filters">
  <div class="category-filters">
    <% categories.forEach((category) => { %>
    <a
      class="filter <%= filters.category === category.key ? 'active' : '' %>"
      href="/listings?category=<%= category.key %>"
    >
      <div><i class="fa-solid <%= category.icon %>"></i></div>
      <p><%= category.label %></p>
    </a>
    <% }) %>
  </div>

  <div class="tax-toggle">
    <div class="form-check form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="switchCheckDefault"
      />
      <label class="form-check-label" for="switchCheckDefault"
        >Display total after taxes</label
      >
    </div>
  </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top"
        alt="listing_image"
        style="height: 20rem"
      />
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b> <%= listing.title %> </b><br />
          &#8377;
          <%= listing.price.toLocaleString("en-IN") %>
          / night
          <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>

<% if (allListings.length === 0) { %>
<div class="text-center py-5">
  <h4>No listings found</h4>
  <p>Try another search or category.</p>
  <a href="/listings" class="btn btn-dark">View all listings</a>
</div>
<% } %>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
